# ==============================================================================
# ModelMind Production & Local Development Environment Variables
# Copy to .env for local use. NEVER commit .env or expose private secrets.
# ==============================================================================

# --- Frontend (Vercel / Vite) ---
# Production Render backend URL (no trailing slash). Leave empty for same-origin local dev.
VITE_API_BASE_URL=""

# Optional: Public anonymous Supabase persistence (leave empty for browser IndexedDB history)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Backend (Render / Express + Python NLP + C++14 Engine) ---
# Server port (Render automatically injects PORT at runtime; local default is 3000)
PORT=3000

# Comma-separated allowed frontend origins for CORS (e.g. https://your-app.vercel.app)
# Use * only during initial testing; set your exact Vercel domain in production.
CORS_ORIGIN="*"

# Optional: Override Python binary path inside custom environments
# PYTHON_BIN="/opt/venv/bin/python3"
